{
  "model": "claude-sonnet-5",
  "effort": "medium",
  "maxTurns": 20,
  "showUsageFooter": true,
  "plan": "pro",
  "caps": {
    "perQueryUsd": 0.3,
    "perUserDailyUsd": 1.5,
    "globalDailyUsd": 2
  },
  "threads": {
    "enabled": true,
    "name": "claude",
    "autoArchiveMinutes": 1440
  },
  "attachments": {
    "maxBytes": 8388608
  },
  "github": {
    "enabled": false,
    "write": false
  },
  "repoAccess": {
    "enabled": true,
    "allowedUserIds": [
      "YOUR_DISCORD_USER_ID"
    ],
    "repos": {
      "example": "C:/path/to/your/repo"
    },
    "denyNames": [
      ".env",
      ".env.local",
      "id_rsa",
      "credentials.json",
      ".claude.json"
    ],
    "denyExtensions": [
      ".pem",
      ".key",
      ".pfx",
      ".p12",
      ".crt"
    ],
    "skipDirs": [
      "node_modules",
      ".git",
      "build",
      "dist",
      ".next",
      "__pycache__",
      "venv",
      ".venv"
    ]
  }
}
