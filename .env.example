# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: fine-grained GitHub PAT, read-only. Only needed if github.enabled is true.
GITHUB_TOKEN=

# Optional: long-lived token from `claude setup-token` (requires a Claude
# subscription). Use this when the bot runs unattended, so it does not break
# when an interactive login expires. If you ran `claude auth login` on this
# machine, leave it blank -- the SDK picks those credentials up automatically.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional. Setting this switches to pay-as-you-go API billing instead of your
# plan's Agent SDK credit. Leave blank to stay on your plan.
ANTHROPIC_API_KEY=
