# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Optional: fine-grained GitHub PAT, read-only. Needed only if github.enabled is true.
GITHUB_TOKEN=

# Optional. Leave BLANK to run on your Claude plan's Agent SDK credit via your
# existing `claude` login. Setting a key switches to pay-as-you-go API billing.
ANTHROPIC_API_KEY=
